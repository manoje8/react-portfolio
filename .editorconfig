# EditorConfig — https://editorconfig.org
# Ensures consistent coding style across all editors/IDEs.

root = true

# ── All files ────────────────────────────────────────────────────────────────
[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 2

# ── Markdown (preserve trailing whitespace for line breaks) ──────────────────
[*.md]
trim_trailing_whitespace = false

# ── Makefile (requires tabs) ─────────────────────────────────────────────────
[Makefile]
indent_style = tab
indent_size  = 4

# ── JSON / YAML ──────────────────────────────────────────────────────────────
[*.{json,yml,yaml}]
indent_size = 2
